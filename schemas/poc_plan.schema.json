{
  "$id": "https://brd-system/schemas/poc_plan.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PoC Planner Output",
  "allOf": [
    { "$ref": "common.schema.json#/definitions/envelope" },
    {
      "type": "object",
      "properties": {
        "poc_scope": { "type": "string" },
        "out_of_scope": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Explicit exclusions — used by Critic to check for scope creep."
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterion_id": { "type": "string" },
              "description": { "type": "string" },
              "measurement": { "type": "string", "description": "How it will be measured, must be quantifiable." },
              "target_value": { "type": "string" }
            },
            "required": ["criterion_id", "description", "measurement"]
          },
          "minItems": 1
        },
        "modular_boundaries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "module_id": { "type": "string" },
              "maps_to_component_id": { "type": "string", "description": "Links to Solution Architect's components[]." },
              "boundary_description": { "type": "string" }
            },
            "required": ["module_id", "boundary_description"]
          }
        },
        "estimated_duration_days": { "type": "integer", "minimum": 1 }
      },
      "required": ["poc_scope", "success_criteria", "modular_boundaries"]
    }
  ]
}
